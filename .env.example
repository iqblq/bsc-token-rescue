# ============================================
# BSC TOKEN RESCUE TOOL - CONFIGURATION
# ============================================
# PENTING: Jangan share file ini ke siapapun!
# File ini berisi private key wallet lo.
# ============================================

# === WALLET COMPROMISED (yang kena sweeper bot) ===
# Private key dari wallet yang kena hack
COMPROMISED_PRIVATE_KEY=your_compromised_wallet_private_key_here

# === WALLET AMAN (yang punya BNB buat gas) ===
# Private key dari wallet aman yang akan kirim BNB gas
FUNDING_PRIVATE_KEY=your_safe_wallet_private_key_here

# === WALLET TUJUAN (tempat token mau dikirim) ===
# Address wallet aman tempat token akan diterima
# Bisa sama dengan funding wallet, atau wallet lain yang aman
DESTINATION_ADDRESS=your_safe_destination_address_here

# === TOKEN CONTRACT ===
# Contract address token yang mau di-rescue
TOKEN_CONTRACT=0x8aab31fbc69c92fa53f600910cf0f215531f8239

# === RPC CONFIGURATION ===
# Public BSC RPC (untuk read data only)
BSC_RPC=https://bsc-rpc.publicnode.com

# bloXroute Protect RPC (untuk kirim tx private, bypass mempool)
BLOXROUTE_RPC=https://bsc.rpc.blxrbdn.com

# NodeReal API Key (optional, untuk bundle tx)
# Daftar gratis di https://nodereal.io
NODEREAL_API_KEY=

# === STRATEGY ===
# pilih: "bloxroute" (recommended, gratis) atau "nodereal" (bundle atomic)
RESCUE_STRATEGY=bloxroute
